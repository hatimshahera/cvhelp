generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  messages      ChatMessage[]
  sources       Source[]
  messageSources ChatMessageSource[]
  profileBank   ProfileBank?
  applications  Application[]
  artifacts     ApplicationArtifact[]
  subscription  Subscription?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id        String        @id @default(cuid())
  title     String        @default("New chat")
  mode      String        @default("general")
  threadKey String        @default("default")
  summary   Json?
  lastSummarizedMessageId String?
  userId    String
  applicationId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@unique([userId, mode, applicationId, threadKey])
  @@index([userId, mode, updatedAt])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources        ChatMessageSource[]

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

model ProfileBank {
  id            String   @id @default(cuid())
  userId        String   @unique
  masterProfile Json?
  rawSources    Json?
  checklist     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id            String         @id @default(cuid())
  userId        String
  company       String
  role          String
  slug          String
  status        String         @default("draft")
  nextAction    String?
  archivedAt    DateTime?
  jobPost       Json
  jobSummary    Json?
  memory        Json?
  candidateSnapshot Json?
  selectedEvidence Json?
  notes         Json?
  drafts        Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  artifacts     ApplicationArtifact[]
  sources       Source[]

  @@unique([userId, slug])
  @@index([userId, updatedAt])
  @@index([userId, status, updatedAt])
}

model ApplicationArtifact {
  id            String      @id @default(cuid())
  userId        String
  applicationId String
  type          String
  title         String
  status        String      @default("draft")
  version       Int         @default(1)
  content       Json
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, type, version])
  @@index([userId, updatedAt])
  @@index([applicationId, type, version])
}

model Source {
  id             String              @id @default(cuid())
  userId         String
  scope          String
  applicationId  String?
  kind           String
  name           String?
  mimeType       String?
  sizeBytes      Int?
  textContent    String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  application    Application?        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  messageSources ChatMessageSource[]

  @@index([userId, scope, createdAt])
  @@index([applicationId, createdAt])
}

model ChatMessageSource {
  id        String      @id @default(cuid())
  userId    String
  messageId String
  sourceId  String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  source    Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([messageId, sourceId])
  @@index([userId, createdAt])
  @@index([sourceId])
}

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  provider               String    @default("stripe")
  providerCustomerId     String?
  providerSubscriptionId String?
  plan                   String    @default("free")
  status                 String    @default("free")
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerCustomerId])
  @@index([providerSubscriptionId])
  @@index([status, updatedAt])
}
